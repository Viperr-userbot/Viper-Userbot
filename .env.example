# ==============================================================================
# 🐍 VIPER USERBOT — COMPLETE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Deploy on Voroa     : https://app.getvoroa.com/
# Upstream Repo       : https://github.com/Viperr-userbot/Viper-Userbot
# Developer & Support : @Gazarkahalwahu (https://t.me/Gazarkahalwahu)
#
# Instructions:
# - Copy or rename this file to `.env` for local/VPS deployment.
# - On Voroa, Render, or Koyeb, copy these variable keys into the
#   Environment Variables / Config settings tab.
# ==============================================================================


# ==============================================================================
# 1. 📱 TELEGRAM ESSENTIALS (MANDATORY — REQUIRED TO START BOT)
# ==============================================================================

# Telegram API ID from https://my.telegram.org
SANGMATA_API_ID=

# Telegram API Hash from https://my.telegram.org
SANGMATA_API_HASH=

# Telethon String Session
# Get instantly via Telegram from: https://t.me/StringFatherRobot (@StringFatherRobot)
# Note: Select 'Telethon' when prompted (Pyrogram is also auto-supported)
# Tip: Normally works directly; if you get an OTP error, message @StringFatherRobot from a secondary account!
# Disclaimer: **We are not responsible for acc ban but its safe dekha jaye to**
# Or generate locally by running : python generate_session.py
SANGMATA_SESSION=

# Telegram Assistant Bot Token from https://t.me/BotFather (@BotFather)
BOT_TOKEN=

# Your Numerical Telegram User ID from https://t.me/userinfobot (@userinfobot)
OWNER_ID=


# ==============================================================================
# 2. 🎮 BOT & GAME SOLVER SETTINGS (PRE-CONFIGURED DEFAULTS)
# ==============================================================================

# Target game bot username (Default: hiddenwordhuntbot)
GAME_BOT=hiddenwordhuntbot

# Command regex trigger for solvers (Default: ^(\.k|\.c)$)
TRIGGER=^(\.k|\.c)$

# Number of puzzle solution attempts/votes (1-7, Default: 3)
VOTES=3


# ==============================================================================
# 3. 🔐 CHAT ENCRYPTION & PRIVACY (OPTIONAL)
# ==============================================================================

# Default global encryption passkey for .enc and .dec commands (Optional)
# If left empty, you can set per-chat passkeys anytime using: .setkey <password>
ENCRYPTION_KEY=


# ==============================================================================
# 4. 🗄️ DATABASE CONFIGURATION (OPTIONAL)
# ==============================================================================

# Free PostgreSQL Database URL from https://neon.tech (or https://neon.com)
# Example: postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require
# If left blank, Viper Userbot automatically uses local lightweight JSON storage!
DATABASE_URL=


# ==============================================================================
# 5. 🤖 AI & LLM PROVIDER KEYS (OPTIONAL — MULTI-TIER FAILOVER)
# ==============================================================================
# Viper Userbot automatically tries providers in order. If a provider hits rate
# limits or fails, it seamlessly cascades to the next available tier!

# ------------------------------------------------------------------------------
# A. Groq Cloud (Ultra-Fast 0.5s Turbo Engine: https://console.groq.com)
# ------------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_API_KEY_BACKUP=
GROQ_API_KEYS=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ------------------------------------------------------------------------------
# B. Google Gemini API (https://aistudio.google.com)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_API_KEYS=

# ------------------------------------------------------------------------------
# C. Mistral AI API — Vision & OCR (https://console.mistral.ai)
# ------------------------------------------------------------------------------
MISTRAL_API_KEY=
MISTRAL_API_KEY_BACKUP=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# ------------------------------------------------------------------------------
# D. OpenRouter API (https://openrouter.ai)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ------------------------------------------------------------------------------
# E. NVIDIA NIM Vision Engine (https://build.nvidia.com)
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ------------------------------------------------------------------------------
# F. SambaNova Cloud API (https://cloud.sambanova.ai)
# ------------------------------------------------------------------------------
SAMBANOVA_API_KEY=
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1

# ------------------------------------------------------------------------------
# G. Hugging Face Access Token (https://huggingface.co/settings/tokens)
# ------------------------------------------------------------------------------
HUGGINGFACE_API_KEY=

# ------------------------------------------------------------------------------
# H. Cloudflare Workers AI
# ------------------------------------------------------------------------------
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# ------------------------------------------------------------------------------
# I. OCR.space API (Optional OCR backup: https://ocr.space/ocrapi)
# ------------------------------------------------------------------------------
OCR_SPACE_API_KEY=

# ------------------------------------------------------------------------------
# J. Custom Proxies & Free Unmetered Fallback Pools
# ------------------------------------------------------------------------------
APINEX_API_KEYS=
APINEX_BASE_URL=https://api.apinex.bond/v1

OPENAGENTIC_API_KEY=
OPENAGENTIC_API_KEYS=
OPENAGENTIC_BASE_URL=https://openagentic.id/api/v1

LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=pixtral-12b-2409

# 100% Free Unmetered Fallback (No API key required)
POLLINATIONS_URL=https://text.pollinations.ai/openai


# ==============================================================================
# 6. 🌐 SERVER, WEBHOOKS & AUTO-UPDATE SETTINGS
# ==============================================================================

# Web server port for healthchecks & webhooks (Default: 8000)
PORT=8000

# Webhook signature secret token (Optional, protects incoming webhooks)
WEBHOOK_SIGNATURE_TOKEN=

# Logging level: INFO, DEBUG, WARNING, ERROR (Default: INFO)
LOG_LEVEL=INFO

# Telethon session file name (Default: hwh_userbot)
SESSION_NAME=hwh_userbot

# Official Upstream repository for .update auto-pull command
UPSTREAM_REPO=https://github.com/Viperr-userbot/Viper-Userbot.git
UPSTREAM_BRANCH=main


# ==============================================================================
# 7. 💬 DEPLOYMENT ASSISTANCE & SUPPORT
# ==============================================================================
